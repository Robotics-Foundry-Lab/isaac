<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation</name>
  <version>0.0.0</version>
  <description>Launch files for the Isaac ROS stack of the robot (RealSense, VSLAM, NVBLOX, Nav2)</description>
  <maintainer email="labor@todo.todo">labor</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>isaac_ros_image_proc</exec_depend>
  <exec_depend>isaac_ros_launch_utils</exec_depend>
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nvblox_ros</exec_depend>
  <exec_depend>nvblox_ros_python_utils</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>realsense_splitter</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
